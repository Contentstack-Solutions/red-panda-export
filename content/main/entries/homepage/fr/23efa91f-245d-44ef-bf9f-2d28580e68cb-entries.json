nt":"blt3b574a0514755be1","locale":"en","time":"2026-01-29T16:21:07.814Z","user":"blteadfeb139f4cab23","version":1},{"environment":"blt4c3cec3a7f2b3942","locale":"en","time":"2026-01-29T16:21:07.814Z","user":"blteadfeb139f4cab23","version":1},{"environment":"bltb7c40d6a6623cbc1","locale":"en","time":"2026-01-29T16:21:07.814Z","user":"blteadfeb139f4cab23","version":1},{"environment":"blt3b574a0514755be1","locale":"es","time":"2026-01-29T16:21:07.814Z","user":"blteadfeb139f4cab23","version":1},{"environment":"blt4c3cec3a7f2b3942","locale":"es","time":"2026-01-29T16:21:07.814Z","user":"blteadfeb139f4cab23","version":1},{"environment":"bltb7c40d6a6623cbc1","locale":"es","time":"2026-01-29T16:21:07.814Z","user":"blteadfeb139f4cab23","version":1},{"environment":"blt3b574a0514755be1","locale":"fr","time":"2026-01-29T16:21:07.814Z","user":"blteadfeb139f4cab23","version":1},{"environment":"blt4c3cec3a7f2b3942","locale":"fr","time":"2026-01-29T16:21:07.814Z","user":"blteadfeb139f4cab23","version":1},{"environment":"bltb7c40d6a6623cbc1","locale":"fr","time":"2026-01-29T16:21:07.814Z","user":"blteadfeb139f4cab23","version":1}]},"vertical_margin":false}},{"product_banner":{"title":"Offres spéciales","_metadata":{"uid":"csee20baf701d928fa"},"description":"Le paradis vous attend...","products":{"data":[{"_id":"672b7d67d4958c72d89eb23f","title":{"en":"Day of Sailing","es":"","de":"","fr":""},"description":{"en":"Escape to paradise with a day of sailing at our luxurious resort in the Maldives. Set sail on the crystal-clear waters of the Indian Ocean aboard a private yacht, where you can soak up the sun, feel the gentle sea breeze on your face, and admire the stunning views of the surrounding islands.\r\n\r\nOur experienced captain will guide you to the best spots for snorkeling, swimming, and sunbathing, allowing you to explore the vibrant marine life and colorful coral reefs that the Maldives are famous for. Enjoy a delicious lunch served on board, featuring fresh seafood and tropical fruits, as you relax and unwind in this idyllic setting.\r\n\r\nWhether you're looking for a romantic getaway, a family adventure, or a solo escape, a day of sailing at our resort in the Maldives promises to be an unforgettable experience.","es":"","de":"","fr":""},"images":[{"url":"https://images.contentstack.io/v3/assets/blt88c061bf071a3331/blt2677e4459f327632/672b7d66faa2f06f4afc7ec7/sailing.jpeg","id":"blt2677e4459f327632"}],"sku":"","price":"$1650","url":"day-of-sailing","custom_data":{"brief_description":"Spend the day sailing, snorkeling, and swimming on a private yacht. Our experienced captain will be your guide for an unforgettable adventure."},"category":{"id":"6723cdc9401a1ad196e6b11a"},"store_id":"RedPandaResortRooms","published":"true"},{"_id":"672b75e6bc321524902a2266","title":{"en":"Drink Package","es":"","de":"","fr":""},"description":{"en":"Indulge in a romantic getaway with our exclusive drink package for two. Enjoy a selection of premium wines, champagne, and cocktails as you relax in the stunning tropical paradise of the Maldives. Sip on your favorite drinks while taking in breathtaking views of the crystal-clear waters and pristine white sandy beaches. Whether you're celebrating a special occasion or simply looking to unwind with your loved one, our drink package for two is the perfect addition to your luxury vacation at Red Panda Resort. Cheers to unforgettable moments and unforgettable memories in paradise.","es":"","de":"","fr":""},"images":[{"url":"https://images.contentstack.io/v3/assets/blt88c061bf071a3331/blte99072ed5d1d3c8b/672b75e441d3f0cf62705d0b/drinks.jpeg","id":"blte99072ed5d1d3c8b"}],"sku":"","price":"$300","url":"drink-package","custom_data":{"brief_description":"Indulge in a romantic getaway with our exclusive drink package for two. Enjoy a selection of premium wines, champagne, and cocktails as you relax in the stunning tropical paradise of the Maldives. "},"category":{"id":"6723cdc9401a1ad196e6b11a"},"store_id":"RedPandaResortRooms","published":"true"},{"_id":"67238fcfd455f7da29849213","title":{"en":"Wildlife Adventure","es":"","de":"","fr":""},"description":{"en":"Immerse yourself in the stunning natural beauty of the Maldives as you explore the diverse marine life and exotic wildlife that call this tropical paradise home.\r\n\r\nYour wildlife tour package includes guided snorkeling and diving excursions to discover the vibrant coral reefs and colorful fish species that thrive in the crystal-clear waters of the Maldives. Swim alongside majestic sea turtles, playful dolphins, and graceful manta rays as you explore the underwater world of the Indian Ocean.\r\n\r\nIn addition to marine life encounters, you will also have the opportunity to explore the lush tropical forests and mangrove swamps of the Maldives on guided nature walks and boat tours. Keep your eyes peeled for rare bird species, elusive reptiles, and other fascinating wildlife that inhabit the islands.\r\n\r\nAfter a day of wildlife exploration, unwind in luxury accommodations at our resort, complete with world-class amenities, gourmet dining options, and breathtaking views of the turquoise waters. Indulge in spa treatments, sunset cruises, and other leisure activities to complete your wildlife tour experience in the Maldives.","es":"","de":"","fr":""},"images":[{"url":"https://images.contentstack.io/v3/assets/blt88c061bf071a3331/bltbb1f6a0e1b3ec24b/67238fceba61ff72b0744685/turtle.jpeg","id":"bltbb1f6a0e1b3ec24b"},{"url":"https://images.contentstack.io/v3/assets/blt88c061bf071a3331/blt145666b36f0cd6e7/67239190c6d07a3d71dec800/parrot.jpeg","id":"blt145666b36f0cd6e7"},{"url":"https://images.contentstack.io/v3/assets/blt88c061bf071a3331/blt81edb656e3baea1a/6723919092ffe6add8f966be/large_bird.jpeg","id":"blt81edb656e3baea1a"},{"url":"https://images.contentstack.io/v3/assets/blt88c061bf071a3331/bltabf655fd606d2a9e/6723919022a686e77d08ed7c/rays.jpeg","id":"bltabf655fd606d2a9e"}],"sku":"","price":"$849","url":"wildlife-adventure","custom_data":{"brief_description":"Immerse yourself in the stunning natural beauty of the Maldives with guided snorkeling, diving excursions, and wildlife encounters. Explore vibrant coral reefs, swim with sea turtles and dolphins, and discover exotic wildlife on nature walks and boat tours."},"category":{"id":"6723cdc9401a1ad196e6b11a"},"store_id":"RedPandaResortRooms","published":"true"}],"type":"secommerce_product"},"plp_link_text":"Voir toutes les offres","plp":[{"uid":"bltcf67e163cb8110c7","_content_type_uid":"plp"}]}}],"seo":{"title":"","description":"","canonical_url":"","no_index":false,"no_follow":false,"show_in_sitemap":true,"show_in_site_search":true,"og_meta_tags":{"title":"","description":"","image":null}},"tags":[],"taxonomies":[{"taxonomy_uid":"locations","term_uid":"fiji"}],"title":"Homepage - Fiji","url":"/","publish_details":[]}}