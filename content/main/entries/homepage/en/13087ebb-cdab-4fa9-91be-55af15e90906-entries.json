f047a","locale":"en","time":"2026-02-03T12:29:35.084Z","user":"bltc2fefc85fa8a3b60","version":1},{"environment":"blt35bb2aa526196fc6","locale":"en","time":"2026-02-03T12:29:35.089Z","user":"bltc2fefc85fa8a3b60","version":1},{"environment":"blt597fc756a4695656","locale":"en","time":"2026-02-03T12:29:35.093Z","user":"bltc2fefc85fa8a3b60","version":1}]},"background_color":{"hsl":{"h":185.99999999999997,"s":0.5,"l":0.9607843137254901,"a":1},"hex":"#f0f9fa","rgb":{"r":240,"g":249,"b":250,"a":1},"hsv":{"h":185.99999999999997,"s":0.03999999999999997,"v":0.9803921568627451,"a":1},"oldHue":246.9064748201439,"source":"rgb"},"text_dark":true,"layout":"Text Right"},{"title":"Attractions","_metadata":{"uid":"cs415ab59acab44d6c"},"tab_text":"Attractions","body":"With 1,190 islands scattered across 26 atolls in the Indian Ocean, including close to 200 resort islands and 200 inhabited islands, there are plenty of places to explore in the Maldives. Despite the numerous options, most visitors choose to lounge at their resort, where restaurants, bars, boutiques and activity centers abound.","image":{"uid":"bltb816e5d855097b04","created_at":"2026-02-03T12:28:10.274Z","updated_at":"2026-02-03T12:28:10.274Z","created_by":"bltc2fefc85fa8a3b60","updated_by":"bltc2fefc85fa8a3b60","content_type":"image/jpeg","file_size":"138305","tags":[],"filename":"attractions.jpeg","url":"https://dev14-images.csnonprod.com/v3/assets/bltd95188221a5ad9ff/bltb816e5d855097b04/6981e9da6ea27578838c249f/attractions.jpeg","ACL":[],"is_dir":false,"parent_uid":"blt83e58f99fa70ecce","_version":1,"title":"attractions.jpeg","publish_details":[{"environment":"blt0555fea4d20f047a","locale":"en","time":"2026-02-03T12:29:35.102Z","user":"bltc2fefc85fa8a3b60","version":1},{"environment":"blt35bb2aa526196fc6","locale":"en","time":"2026-02-03T12:29:35.107Z","user":"bltc2fefc85fa8a3b60","version":1},{"environment":"blt597fc756a4695656","locale":"en","time":"2026-02-03T12:29:35.112Z","user":"bltc2fefc85fa8a3b60","version":1}]}